    "babel-preset-expo": "^57.0.7",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg-kit.mjs",
    "postinstall": "node scripts/fetch-ffmpeg-kit.mjs || echo \"ffmpeg-kit AAR not fetched — run npm run ffmpeg:fetch before building\"",
    "apk": "npm run ffmpeg:fetch && expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx tests/run.ts",
    "test:agent": "tsx tests/run-agent-only.ts"
  },
  "private": true
